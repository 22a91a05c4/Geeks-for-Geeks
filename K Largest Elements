class Solution {
    public ArrayList<Integer> kLargest(int[] arr, int k) {
        ArrayList<Integer> ans = new ArrayList<Integer>();
        Arrays.sort(arr);
        for(int i=(arr.length)-1;i>=0;i--)
        {   
            if(k>0)
            {
                ans.add(arr[i]);
                k--;
            }
        }
        return ans;
    }
}
