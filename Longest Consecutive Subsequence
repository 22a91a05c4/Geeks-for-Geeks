class Solution {

    // Function to return length of longest subsequence of consecutive integers.
    public int longestConsecutive(int[] arr) {
        Arrays.sort(arr);
        int c=1;
        int ml=1;
        for(int i=1;i<arr.length;i++)
        {
            if(arr[i]==arr[i-1])  continue;
            if(arr[i]-arr[i-1]==1)
            {
                c++;
            }
            else
            {
                ml=Math.max(ml,c);
                c=1;
            }
        }
        return Math.max(ml,c);
    }
}
