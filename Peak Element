class Solution {

    public int peakElement(int[] arr) {
        int an=-1;
        if(arr.length==1)
        {
            an=0;
        }
        else
        {
            if(arr[0]>arr[1])
            {
                an=0;
            }
            else if(arr[arr.length-1]>arr[arr.length-2])
            {
                an=arr.length-1;
            }
            else
            {
                for(int i=1;i<arr.length-1;i++)
                {
                    if(arr[i-1]<arr[i] && arr[i]>arr[i+1])
                    {
                        an=i;
                        break;
                    }
                }
            }
        }
        return an;
    }
}
